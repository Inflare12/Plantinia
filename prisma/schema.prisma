generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String               @id @default(cuid())
  email                        String               @unique
  passwordHash                 String
  name                         String
  avatarUrl                    String?
  role                         Role                 @default(USER)
  isEmailVerified              Boolean              @default(false)
  verificationToken            String?
  verificationCode             String?
  verificationCodeExpiresAt    DateTime?
  resetPasswordToken           String?
  subscriptionTier             SubscriptionTier     @default(FREE)
  subscriptionStatus           SubscriptionStatus   @default(ACTIVE)
  subscriptionCurrentPeriodEnd DateTime?
  paymentProvider              String?
  subscriptionId               String?
  creditsRemaining             Int                  @default(5)
  apiKey                       String?              @unique
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  careTasks                    CarePlanTask[]
  chatMessages                 ChatMessage[]
  diagnoses                    Diagnosis[]
  invoices                     Invoice[]
  plants                       Plant[]
  timelineEvents               PlantTimelineEvent[]
  feedback                     UserFeedback[]
}

model Plant {
  id                    String               @id @default(cuid())
  userId                String
  name                  String
  species               String
  commonName            String
  imageUrl              String
  location              String               @default("indoor")
  healthStatus          HealthStatus         @default(HEALTHY)
  sunlightNeeds         String               @default("indirect")
  wateringFrequencyDays Int                  @default(7)
  lastWateredDate       DateTime?
  nextWateringDate      DateTime?
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  careTasks             CarePlanTask[]
  diagnoses             Diagnosis[]
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  timelineEvents        PlantTimelineEvent[]
  @@index([userId])
  @@index([species])
  @@index([healthStatus])
}

model Diagnosis {
  id                    String       @id @default(cuid())
  userId                String
  plantId               String?
  mediaType             String       @default("image")
  mediaUrl              String
  identifiedSpecies     String
  diseaseName           String
  pathogenType          PathogenType @default(NONE)
  confidence            Float
  severity              Severity     @default(MILD)
  uncertainty           String?      @default("low") // "low" | "medium" | "high"
  symptoms              Json
  causes                Json
  prognosis             String
  treatmentSteps        Json
  organicRemedies       Json
  chemicalRemedies      Json
  preventativeMeasures  Json
  boundingBoxes         Json?
  aiProviderUsed        String
  modelVersion          String?      // Track which model version was used
  candidates            Json?       // Alternative diagnoses when uncertainty is high
  knowledgeReferences   Json?       // References to knowledge base items used
  adminReviewed         Boolean      @default(false)
  adminAccuracyFeedback String?
  createdAt             DateTime     @default(now())
  plant                 Plant?       @relation(fields: [plantId], references: [id])
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback              UserFeedback[]
  @@index([userId])
  @@index([plantId])
  @@index([createdAt])
}

model PlantTimelineEvent {
  id          String   @id @default(cuid())
  plantId     String
  userId      String
  eventType   String
  title       String
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CarePlanTask {
  id          String   @id @default(cuid())
  userId      String
  plantId     String?
  plantName   String?
  title       String
  category    String
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  plant       Plant?   @relation(fields: [plantId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  plantId   String?
  role      String
  content   String
  mediaUrl  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KnowledgeItem {
  id             String   @id @default(cuid())
  type           String   // "plant" | "disease" | "pest" | "symptom" | "nutrient_deficiency"
  name           String
  scientificName String?  @unique
  commonNames    Json?    // Array of common names
  category       String?
  description    String?
  affectedPlants Json?    // Array of plant IDs or names
  symptoms       Json?    // Array of symptoms
  treatment      Json?    // Treatment information
  prevention     Json?    // Prevention information
  sources        Json?    // Array of source references
  imageUrl       String?
  metadata       Json?    // Additional flexible metadata
  isActive       Boolean  @default(true)
  lastUpdated    DateTime @default(now())
  @@index([type])
  @@index([scientificName])
  @@index([isActive])
}

model Invoice {
  id                String   @id @default(cuid())
  userId            String
  amount            Float
  currency          String   @default("INR")
  provider          String
  providerPaymentId String
  status            String   @default("paid")
  plan              String
  receiptUrl        String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserFeedback {
  id           String   @id @default(cuid())
  userId       String
  diagnosisId  String   @unique
  wasCorrect   Boolean
  correction   String?
  notes        String?
  timestamp    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnosis    Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([diagnosisId])
}

model ModelMetadata {
  id              String   @id @default(cuid())
  name            String
  version         String   @unique
  type            String   // "plant_identification" | "disease_detection" | "pest_detection" | "image_embedding"
  status          String   @default("staging") // "active" | "staging" | "deprecated"
  description     String
  trainedOn       String
  accuracy        Float?
  classes         Json?     // Array of class names
  inputSize       Json?     // { width: number, height: number }
  preprocessing   Json?     // Array of preprocessing steps
  lastUpdated     DateTime @default(now())
  license         String?
  citation        String?
  isActive        Boolean  @default(false)
  registeredAt    DateTime @default(now())
  @@index([type])
  @@index([status])
  @@index([isActive])
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  FARM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  CANCELED
  PAST_DUE
}

enum HealthStatus {
  HEALTHY
  WARNING
  CRITICAL
  TREATING
}

enum PathogenType {
  FUNGAL
  BACTERIAL
  VIRAL
  PEST
  ENVIRONMENTAL
  NONE
}

enum Severity {
  MILD
  MODERATE
  SEVERE
  CRITICAL
}

