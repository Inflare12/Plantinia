# ==============================================================================
# PLANTINIA PRODUCTION CONFIGURATION & ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="super-secret-plantinia-jwt-token-min-32-chars-long"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL / Supabase / Neon / Local SQLite)
# Free launch: Neon.tech (0.5 GB Postgres free) or Supabase (500 MB Postgres free)
# In local development without Postgres, leave empty or use sqlite: file:./dev.db
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 3. MODULAR AI INFERENCE ENGINE
# Plantinia keeps heavy AI models external to Vercel.
# Options: 'gemini' | 'openai' | 'custom' | 'mock'
# Default: 'gemini' (Google Gemini 1.5 Flash has 15 free requests/min - $0 cost!)
# ------------------------------------------------------------------------------
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Optional OpenAI Fallback:
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional Custom Model Inference Server (Dedicated GPU / Triton / FastAPI / RunPod):
CUSTOM_INFERENCE_URL=""
CUSTOM_INFERENCE_API_KEY=""

# ------------------------------------------------------------------------------
# 4. PAYMENTS & MONETIZATION
# Primary India: Razorpay (Cards, UPI, NetBanking)
# International: Stripe (Cards, Apple Pay, Google Pay)
# ------------------------------------------------------------------------------
# Razorpay Credentials (Test keys start with rzp_test_):
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyHere"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Stripe Credentials (Test keys start with sk_test_ / pk_test_):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YourKeyHere"
STRIPE_SECRET_KEY="sk_test_YourSecretKeyHere"
STRIPE_WEBHOOK_SECRET="whsec_YourWebhookSecret"

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (Plant Photos, Leaf Scans, PDF Reports)
# Free launch: 'local' (saves to local/data URI) or 'r2' (Cloudflare R2: 10GB free forever)
# Options: 'local' | 'r2' | 's3' | 'supabase'
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="local"
S3_BUCKET="plantinia-uploads"
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
NEXT_PUBLIC_STORAGE_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (Verification, Welcome, Treatment Alerts)
# Free launch: 'mock' (prints to server console) or 'resend' (3,000 free emails/month)
# Options: 'mock' | 'resend' | 'smtp'
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
EMAIL_FROM="Plantinia Doctor <notifications@plantinia.app>"

# ------------------------------------------------------------------------------
# 7. WEB PUSH & MOBILE NOTIFICATIONS
# Generated with `npx web-push generate-vapid-keys`
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@plantinia.app"

# ------------------------------------------------------------------------------
# 8. WEATHER & SATELLITE AGRONOMY API
# Free launch: Open-Meteo (10,000 free requests/day without any API key required!)
# WeatherAPI.com (optional fallback)
# ------------------------------------------------------------------------------
WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=""
